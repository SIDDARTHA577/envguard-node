{
  "openapi": "3.1.0",
  "info": {
    "title": "Deep Healthy Backend API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": { "description": "Server healthy" }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List tenant projects",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "List of projects" },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
