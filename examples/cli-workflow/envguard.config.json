{
  "schema": {
    "NODE_ENV": {
      "type": "enum",
      "values": ["development", "staging", "production"],
      "default": "development"
    },
    "PORT": {
      "type": "port",
      "default": 8080
    },
    "REDIS_URL": {
      "type": "url",
      "protocols": ["redis:", "rediss:"],
      "required": true,
      "sensitive": true
    },
    "JWT_SECRET": {
      "type": "string",
      "min": 32,
      "required": true,
      "sensitive": true
    }
  }
}
